# Server & Port Binding (Bind to 127.0.0.1 behind Nginx reverse proxy)
HOST_BIND_IP=127.0.0.1
CLOUD_LOGS_PORT=8000

# Database (SQLite default for easy setup, or sqlite+aiosqlite:///./cloud_logs.db)
DATABASE_URL=sqlite+aiosqlite:///./cloud_logs.db

# Master Token (raw key or SHA-256 hex hash)
MASTER_API_KEY=hlp_live_supersecret_admin_token_change_in_production
# MASTER_API_KEY_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# JWT Security
JWT_SECRET=supersecret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_ORG_NAME=Hyperloop-UPV

# Google Drive Storage
GDRIVE_ROOT_FOLDER_ID=your_google_drive_parent_folder_id
GDRIVE_SERVICE_ACCOUNT_PATH=/path/to/service_account.json
# Set to true ONLY if explicitly testing without Google credentials
GDRIVE_SIMULATION_MODE=false

# Automatic Weekly Cleanup (1 month retention)
CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=168

# App & CORS
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
